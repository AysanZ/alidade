{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@alidade/core": ["../../packages/core/src/index.ts"],
      "@alidade/maplibre": ["../../packages/maplibre/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
