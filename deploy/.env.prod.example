# deploy/.env.prod.example  →  copy to /opt/alidade/.env on the server
#
# This file is never committed. Generate the password on the server itself:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32

# --- registry -------------------------------------------------------------
# Your GitHub username or org, lowercased. GHCR image paths are case-sensitive
# and always lowercase, even when the account is not.
GHCR_OWNER=aysan

# Written by the deploy workflow on every release. Set it to a previous commit
# SHA and re-run `up -d` to roll back — that is the whole rollback procedure.
TAG=latest

# --- TLS ------------------------------------------------------------------
# Let's Encrypt sends expiry warnings here if renewal ever starts failing.
ACME_EMAIL=you@aysanz.dev

# --- database -------------------------------------------------------------
POSTGRES_USER=alidade
POSTGRES_PASSWORD=CHANGE_ME_generate_a_real_one
POSTGRES_DB=alidade
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- api ------------------------------------------------------------------
# Must be the exact origin the browser sends, scheme included and no trailing
# slash. A mismatch here shows up as every API call failing in the console
# while curl from the server works perfectly.
CORS_ORIGINS=https://alidade.aysanz.dev

# A week. Nginx caches tiles on disk as well; this is the browser's copy.
TILE_CACHE_SECONDS=604800

# 10 MB. Nginx refuses anything larger before Python is involved.
MAX_UPLOAD_MB=10

# --- live feed ------------------------------------------------------------
# Sixty vehicles at 1 Hz is about 60 messages a second per connected viewer.
# Fine for a portfolio; lower the fleet if you ever get a crowd.
LIVE_FLEET_SIZE=60
LIVE_CENTRE_LON=51.39
LIVE_CENTRE_LAT=35.69
LIVE_INTERVAL_SECONDS=1.0
