# Copy to /opt/alidade/.env and fill in. Never committed.
# Password: openssl rand -base64 32 | tr -d '/+=' | head -c 32

# Registry. Lowercase GitHub username or org.
GHCR_OWNER=aysanz
# Set by the deploy workflow. A previous SHA here plus `up -d` is a rollback.
TAG=latest

POSTGRES_USER=alidade
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alidade
DB_POOL_MIN=1
DB_POOL_MAX=5

# Exact origin, no trailing slash.
CORS_ORIGINS=https://alidade.aysanz.dev
TILE_CACHE_SECONDS=604800
MAX_UPLOAD_MB=10

LIVE_FLEET_SIZE=60
LIVE_CENTRE_LON=51.39
LIVE_CENTRE_LAT=35.69
LIVE_INTERVAL_SECONDS=1.0
