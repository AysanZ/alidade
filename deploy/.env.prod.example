# Copy to /opt/alidade/.env and fill in. Never committed.
# Password: openssl rand -base64 32 | tr -d '/+=' | head -c 32

# Registry. Lowercase GitHub username or org.
GHCR_OWNER=CHANGE_ME
# Set by the deploy workflow. A previous SHA here plus `up -d` is a rollback.
TAG=latest

POSTGRES_USER=alidade
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alidade
DB_POOL_MIN=1
DB_POOL_MAX=5

# Sent in an X-Alidade-Write header on POST/PUT/PATCH/DELETE. Leave it empty and
# every write is open, which is what a public demo with a nightly reset wants.
# openssl rand -hex 24
WRITE_TOKEN=

# Layers a delete request will not touch, comma separated. The map you curated,
# so the first visitor who finds the button cannot clear it.
PROTECTED_LAYERS=

# Imagery on a small disk. The API refuses a file over MAX_RASTER_MB; nginx
# refuses a body over RASTER_BODY before the API sees a byte.
MAX_RASTER_MB=512
RASTER_BODY=512m

# Exact origin, no trailing slash.
CORS_ORIGINS=https://CHANGE_ME
TILE_CACHE_SECONDS=604800
# Vector uploads. nginx refuses a body over UPLOAD_BODY; the API refuses a file
# over MAX_UPLOAD_MB and says by how much, so keep UPLOAD_BODY a little larger.
MAX_UPLOAD_MB=64
UPLOAD_BODY=80m

LIVE_FLEET_SIZE=60
LIVE_CENTRE_LON=51.39
LIVE_CENTRE_LAT=35.69
LIVE_INTERVAL_SECONDS=1.0
