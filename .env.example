# Postgres
POSTGRES_USER=alidade
POSTGRES_PASSWORD=change_me
POSTGRES_DB=alidade
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
# Host side only. 5432 is usually taken by a local postgres.
POSTGRES_HOST_PORT=5433

# API
API_PORT=8000
# Nginx, which serves the built studio. Only needed for a deployment.
NGINX_PORT=8088
TILE_CACHE_SECONDS=300
CORS_ORIGINS=http://localhost:5173

# Imagery. A GeoTIFF is a file on a volume rather than rows in Postgres, so it
# gets a ceiling of its own instead of sharing the one that a Shapefile uses.
MAX_RASTER_MB=4096
# MAX_UPLOAD_MB and MAX_MOSAIC_ASSETS are API settings too, with sensible
# defaults (200 MB and 6). They are not passed through by the compose file:
# add them to the api service's environment if you need to change them.

# Live feed. The API ships a simulated fleet so the studio has something to
# connect to without one attached; point the endpoint at a real source and none
# of these matter. The centre is where the fleet drives around.
LIVE_FLEET_SIZE=60
LIVE_CENTRE_LON=51.39
LIVE_CENTRE_LAT=35.69
LIVE_INTERVAL_SECONDS=1.0
